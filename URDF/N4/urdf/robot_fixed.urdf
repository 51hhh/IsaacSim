<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed URDF for Isaac Sim - renamed links and meshes for valid USD paths -->
<!-- Original: SolidWorks to URDF Exporter -->
<!-- Fixed: All names starting with numbers renamed to valid USD identifiers -->
<robot name="N4">
  <link name="base_link"/>

  <!-- Fixed joint connecting body to base_link -->
  <joint name="virtual_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="body">
    <inertial>
      <origin xyz="0 0 0.0378841261362945" rpy="0 0 0"/>
      <mass value="16.2401302143576"/>
      <inertia ixx="1.00866947049631" ixy="0" ixz="0" iyy="1.02437247049631" iyz="0" izz="1.97949189323505"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/body.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/body.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Front Left Steering -->
  <link name="steer_FL">
    <inertial>
      <origin xyz="0.0122555607739784 0 -0.0460182765859516" rpy="0 0 0"/>
      <mass value="0.234446139501678"/>
      <inertia ixx="0.000289619323760121" ixy="0" ixz="0" iyy="0.000289616691925895" iyz="0" izz="0.000281847941925895"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/steer_FL.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/steer_FL.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL" type="continuous">
    <origin xyz="-0.32 0.315 0" rpy="-3.1416 0 3.1416"/>
    <parent link="body"/>
    <child link="steer_FL"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1.2" velocity="30"/>
    <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="wheel_FL">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.285099533313274"/>
      <inertia ixx="0.000236988987066659" ixy="0" ixz="0" iyy="0.000236988987066659" iyz="0" izz="0.000431213044136327"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/wheel_FL.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://N4/meshes/wheel_FL.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="FLW" type="continuous">
    <origin xyz="0 0 -0.0279" rpy="-1.5708 0 1.5708"/>
    <parent link="steer_FL"/>
    <child link="wheel_FL"/>
    <axis xyz="0 0 1"/>
    <limit effort="8" velocity="50"/>
    <dynamics damping="0.02" friction="0.05"/>
  </joint>

